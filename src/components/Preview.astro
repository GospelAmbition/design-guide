---
import brands from '../data/brands.json';
const { brand } = Astro.props;
const b = brands.find((x) => x.id === brand);
---
<div data-brand={brand} class="brand-canvas">
  <h2>Welcome to {b.meta.name}</h2>
  <p>This is how body text, headings and components look using only the {b.meta.name} tokens.</p>
  <p class="muted">Muted caption text for secondary information.</p>
  <div class="row">
    <button class="btn btn-primary">Primary action</button>
    <button class="btn btn-secondary">Secondary</button>
    <span class="tag">Tag</span>
  </div>
  <div class="row"><input placeholder="Email address" aria-label="Email address" /></div>
  <div class="card">
    <h3>Card title</h3>
    <p>Cards group related content on a surface with a border and a medium radius.</p>
    <button class="btn btn-primary">Learn more</button>
  </div>
</div>
