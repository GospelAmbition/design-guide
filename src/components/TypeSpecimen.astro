---
import brands from '../data/brands.json';
const { brand } = Astro.props;
const b = brands.find((x) => x.id === brand);
const levels = [['step-4', 'h1', 'Heading one'], ['step-3', 'h2', 'Heading two'], ['step-2', 'h3', 'Heading three'], ['step-1', 'h4', 'Lead paragraph text'], ['step-0', 'body', 'Body text sits at the base size and is used for most content.']];
const size = (s) => b.tokens.size.find((t) => t.name === 'size-' + s).value;
---
<div data-brand={brand}>
  <div class="ds-specimen">
    {levels.map(([s, role, text]) => (
      <div>
        <span class="label">{role} · --size-{s} · {size(s)}</span>
        <div style={`font-size:var(--size-${s});font-family:${role === 'body' || role === 'h4' ? 'var(--font-body)' : 'var(--font-heading)'};font-weight:${role === 'body' ? 400 : 600}`}>{text}</div>
      </div>
    ))}
  </div>
</div>
<table class="ds-table">
  <thead><tr><th>Token</th><th>Value</th><th>Use</th></tr></thead>
  <tbody>
    {[...b.tokens.font, ...b.tokens.size].map((t) => <tr><td><code>--{t.name}</code></td><td><code>{t.value}</code></td><td>{t.description}</td></tr>)}
  </tbody>
</table>
