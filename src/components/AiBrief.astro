---
import { readFileSync } from 'node:fs';
const { brand } = Astro.props;
const brief = readFileSync(`public/guides/${brand}.md`, 'utf8');
---
<div class="ds-brief">
  <p>
    <button type="button" data-copy>Copy brief to clipboard</button>
    &nbsp;<a href={`/guides/${brand}.md`} download>Download .md</a> ·
    <a href={`/tokens/${brand}.css`} download>Download CSS variables</a>
  </p>
  <pre id={`brief-${brand}`}>{brief}</pre>
</div>
<script>
  document.querySelectorAll('.ds-brief').forEach((el) => {
    const btn = el.querySelector('[data-copy]');
    btn?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(el.querySelector('pre').textContent);
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy brief to clipboard'), 1500);
    });
  });
</script>
