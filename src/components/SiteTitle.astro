---
// Wraps Starlight's site title with a button that minimises the sidebar on desktop.
// The choice is kept in localStorage; the head script in astro.config.mjs applies it before paint.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<button type="button" class="ds-sidebar-toggle" aria-controls="starlight__sidebar" aria-expanded="true" title="Hide sidebar">
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <path d="M9 4v16" />
  </svg>
  <span class="sr-only">Toggle sidebar</span>
</button>
<Default />

<script>
  const KEY = 'ds-sidebar-collapsed';
  const root = document.documentElement;
  const sync = (btn: HTMLButtonElement) => {
    const collapsed = root.hasAttribute('data-sidebar-collapsed');
    btn.setAttribute('aria-expanded', String(!collapsed));
    btn.title = collapsed ? 'Show sidebar' : 'Hide sidebar';
  };
  document.querySelectorAll<HTMLButtonElement>('.ds-sidebar-toggle').forEach((btn) => {
    sync(btn);
    btn.addEventListener('click', () => {
      const collapsed = !root.hasAttribute('data-sidebar-collapsed');
      root.toggleAttribute('data-sidebar-collapsed', collapsed);
      try {
        collapsed ? localStorage.setItem(KEY, '1') : localStorage.removeItem(KEY);
      } catch {}
      sync(btn);
    });
  });
</script>

<style>
  .ds-sidebar-toggle {
    display: none;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    margin-inline-end: 0.5rem;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .ds-sidebar-toggle:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  /* Only on desktop, and only on pages that have a sidebar. Mobile keeps Starlight's menu button. */
  @media (min-width: 50em) {
    :global(:root[data-has-sidebar]) .ds-sidebar-toggle {
      display: inline-flex;
    }
  }
</style>
