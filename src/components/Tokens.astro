---
// Swatches (with contrast per mode), a type specimen and a table of all other tokens.
import { flattenTokens } from '../../scripts/lib/brands.mjs';
const { brand } = Astro.props;

const lum = (hex) => {
  const c = hex.replace('#', '').match(/../g).map((h) => parseInt(h, 16) / 255)
    .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ratio = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return (x + 0.05) / (y + 0.05); };
const grade = (r) => (r >= 4.5 ? 'AA text' : r >= 3 ? 'large text/UI only' : 'decorative only');

const base = flattenTokens(brand.tokens);
const modes = [{ mode: 'light', tokens: base }, ...brand.modes.map((m) => ({ mode: m.mode, tokens: flattenTokens(m.tokens) }))];
const value = (mode, name) => (mode.tokens.find((t) => t.name === name) ?? base.find((t) => t.name === name))?.value;
const colours = base.filter((t) => t.type === 'color');
const get = (name) => base.find((t) => t.name === name)?.value;
// Brands name their type scale either by step (step-4 … step-0) or by element (h1 … h5, body).
const levels = get('size-h1')
  ? [['h1', 'h1'], ['h2', 'h2'], ['h3', 'h3'], ['h4', 'h4'], ['h5', 'h5'], ['body', 'body'], ['small', 'small']]
  : [['step-4', 'h1'], ['step-3', 'h2'], ['step-2', 'h3'], ['step-1', 'h4 / lead'], ['step-0', 'body'], ['small', 'small']];
// Display fonts (e.g. Bebas Kai) only for the levels that use them: h4/h5 may be set in the body font.
const headingFont = (role) => (get('size-h1') ? ['h1', 'h2', 'h3'].includes(role) : role.startsWith('h'));
// Resolve {color.x} references so gradients can be previewed.
const resolve = (v) => String(v).replace(/\{([\w.-]+)\}/g, (_, ref) => get(ref.replaceAll('.', '-')) ?? _);
const swatches = base.filter((t) => t.type === 'gradient' || t.type === 'shadow');
const others = base.filter((t) => t.type !== 'color' && !swatches.includes(t));
---
<h2>Colour</h2>
<p>Contrast is measured in the same mode: <code>--color-on-X</code> against <code>--color-X</code>, everything else against <code>--color-background</code>.</p>
{modes.map((mode) => (
  <>
    {modes.length > 1 && <h3>{mode.mode}</h3>}
    <div class="ds-grid">
      {colours.map((t) => {
        const v = value(mode, t.name);
        const on = ratio(v, '#ffffff') >= ratio(v, '#000000') ? '#fff' : '#000';
        // on-X colours are measured against X; everything else against the page background.
        const against = t.name.startsWith('color-on-') ? t.name.replace('color-on-', 'color-') : 'color-background';
        const r = ratio(v, value(mode, against));
        return (
          <div class="ds-swatch">
            <div class="ds-swatch__chip" style={`background:${v};color:${on}`}>{v.toUpperCase()}</div>
            <div class="ds-swatch__body">
              <code>--{t.name}</code>
              <div class="ds-swatch__desc">{t.description}</div>
              {t.name !== 'color-background' && <div class="ds-swatch__desc">{r.toFixed(1)}:1 on {against.replace('color-', '')} ({grade(r)})</div>}
            </div>
          </div>
        );
      })}
    </div>
  </>
))}

<h2>Type</h2>
<div class="ds-specimen" style={`background:${get('color-background')};color:${get('color-text')}`}>
  {levels.filter(([s]) => get(`size-${s}`)).map(([s, role]) => {
    const heading = headingFont(role);
    // A heading level set in the body font (h4/h5 when the scale names elements) is a bold uppercase label.
    const label = !heading && get('size-h1') && /^h\d$/.test(role);
    const style = heading
      ? `font-family:${get('font-heading')};font-weight:${get('weight-heading')};line-height:${get('leading-heading')}`
      : label
        ? `font-family:${get('font-body')};font-weight:${get('weight-strong')};line-height:${get('leading-heading')};text-transform:uppercase`
        : `font-family:${get('font-body')};font-weight:${get('weight-regular')};line-height:${get('leading-body')}`;
    return (
      <div>
        <span class="label">{role} · --size-{s} · {get(`size-${s}`)}</span>
        <div style={`font-size:${get(`size-${s}`)};${style}`}>
          {heading || label ? `${role} — The quick brown fox` : 'Body text sits at the base size and is used for most content on the page.'}
        </div>
      </div>
    );
  })}
</div>

{swatches.length > 0 && (
  <>
    <h2>Gradients and shadows</h2>
    <div class="ds-grid">
      {swatches.map((t) => (
        <div class="ds-swatch">
          <div class="ds-swatch__chip" style={t.type === 'gradient' ? `background:${resolve(t.value)}` : `background:#fff;margin:1rem;height:52px;border-radius:8px;${String(t.description).includes('drop-shadow') ? `filter:drop-shadow(${t.value})` : `box-shadow:${t.value}`}`}></div>
          <div class="ds-swatch__body">
            <code>--{t.name}</code>
            <div class="ds-swatch__desc"><code>{resolve(t.value)}</code></div>
            <div class="ds-swatch__desc">{t.description}</div>
          </div>
        </div>
      ))}
    </div>
  </>
)}

<h2>All other tokens</h2>
<table class="ds-table">
  <thead><tr><th>Variable</th><th>Value</th><th>Use</th></tr></thead>
  <tbody>
    {others.map((t) => <tr><td><code>--{t.name}</code></td><td><code>{t.value}</code></td><td>{t.description}</td></tr>)}
  </tbody>
</table>
