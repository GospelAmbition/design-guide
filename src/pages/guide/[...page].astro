---
// Human viewer for each brand, built straight from brands/ and system/.
// /guide/<id>/                       overview: guidelines + every component at a glance
// /guide/<id>/tokens/                swatches, type, token table
// /guide/<id>/components/<name>/     the resolved component (shared, override or brand-only)
// /guide/<id>/patterns/<name>/
// /guide/<id>/utilities/            generated utilities and surfaces
// /guide/<id>/assets/
// /guide/<id>/brief/                 the generated brief, for copy-paste
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import { getCollection, render } from 'astro:content';
import { loadAll, read, fences, KINDS, fontHref, isUrl, iconSets } from '../../../scripts/lib/brands.mjs';
import BrandContext from '../../components/BrandContext.astro';
import Tokens from '../../components/Tokens.astro';
import { withBase } from '../../lib/base.mjs';
import { utilityRules, surfaces } from '../../../scripts/lib/brand-css.mjs';
import { surfaceContrast } from '../../../scripts/generate.mjs';

export function getStaticPaths() {
  const { brands } = loadAll();
  return brands.flatMap((b) => [
    { params: { page: b.id }, props: { id: b.id, view: 'overview' } },
    { params: { page: `${b.id}/tokens` }, props: { id: b.id, view: 'tokens' } },
    { params: { page: `${b.id}/utilities` }, props: { id: b.id, view: 'utilities' } },
    { params: { page: `${b.id}/assets` }, props: { id: b.id, view: 'assets' } },
    { params: { page: `${b.id}/brief` }, props: { id: b.id, view: 'brief' } },
    ...KINDS.flatMap((kind) => b[kind].map((d) => ({ params: { page: `${b.id}/${kind}/${d.name}` }, props: { id: b.id, view: 'doc', kind, name: d.name } }))),
  ]);
}

const { id, view, kind, name } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const brand = loadAll().brands.find((b) => b.id === id);
const m = brand.meta;

const entries = [...(await getCollection('brandFiles')), ...(await getCollection('systemFiles'))];
const entryFor = async (path) => {
  const e = entries.find((x) => x.filePath?.replaceAll('\\', '/').endsWith(path));
  return e ? (await render(e)).Content : null;
};
let title = m.name, description = m.summary, Content = null, doc = null, overview = '';
if (view === 'overview') {
  Content = await entryFor(`brands/${id}/guidelines.md`);
  overview = withBase(base, brand.components.map((d) => fences(d.body).find((f) => f.lang === 'html')?.code ?? '').join('\n'));
} else if (view === 'tokens') {
  title = `${m.name} tokens`;
} else if (view === 'utilities') {
  title = `${m.name} utilities and surfaces`;
} else if (view === 'assets') {
  title = `${m.name} assets`;
  Content = await entryFor(`brands/${id}/assets/assets.md`);
} else if (view === 'brief') {
  title = `${m.name} brief for AI`;
} else {
  doc = brand[kind].find((d) => d.name === name);
  title = `${m.name}: ${doc.data.title ?? doc.name}`;
  description = doc.data.summary;
  Content = await entryFor(doc.path);
}

const head = (m.fonts ?? []).map((u) => ({ tag: 'link', attrs: { rel: 'stylesheet', href: isUrl(u) ? u : `${base}/${fontHref(brand, u)}` } }));
const icons = iconSets(m);
const utilities = view === 'utilities' ? utilityRules(brand) : [];
const surfaceList = view === 'utilities' ? surfaces(brand).map((x) => ({
  ...x,
  ratios: x.roles.filter((r) => r !== 'background').map((r) => `${r} ${surfaceContrast(brand, x.name, r)?.toFixed(1) ?? '?'}:1`).join(', '),
})) : [];
const surfaceDemo = surfaceList.map((x) => `<div class="surface-${x.name} box demo-fill"><strong>.surface-${x.name}</strong> Text on this surface${x.roles.includes('link') ? ' with <a href="/">a link</a>' : ''}.</div>`).join('\n');
const brief = view === 'brief' ? read(`brands/${id}/brief.md`) : '';
---
<StarlightPage frontmatter={{ title, description, head }}>
  <BrandContext brand={brand}>
    {view === 'overview' && (
      <>
        <p>{m.summary}</p>
        <h2>At a glance</h2>
        <ds-preview><template set:html={overview} /></ds-preview>
        <Content />
        <h2>Icons</h2>
        {icons.length === 1 && !icons[0].use ? <p>{icons[0].name}</p> : (
          <ul>{icons.map((s) => <li><strong>{s.name}</strong>{s.use && <> — {s.use}</>}{s.source && <><br /><small>Source: {s.source}</small></>}</li>)}</ul>
        )}
        <p class="ds-source">Source: <code>brands/{id}/guidelines.md</code></p>
      </>
    )}
    {view === 'tokens' && (
      <>
        <Tokens brand={brand} />
        <p class="ds-source">Source: <code>brands/{id}/tokens.json</code>{brand.modes.map((x) => <>, <code>{x.path}</code></>)}</p>
      </>
    )}
    {view === 'utilities' && (
      <>
        <p>Generated into <code>brand.css</code> from the tokens, by <code>system/utilities.json</code>{brand.utilitiesConfig.length > 0 && <> and <code>{brand.dir}/utilities.json</code></>}. One class, one job. Use them in the HTML instead of writing CSS.</p>
        <h2>Surfaces</h2>
        <p>A background with the text and link colours that pass contrast on it. Set from <code>surface.*</code> in <code>tokens.json</code>.</p>
        <ds-preview><template set:html={surfaceDemo} /></ds-preview>
        <table>
          <thead><tr><th>Class</th><th>Contrast</th><th>Notes</th></tr></thead>
          <tbody>{surfaceList.map((x) => <tr><td><code>.surface-{x.name}</code></td><td>{x.ratios}</td><td>{x.description}</td></tr>)}</tbody>
        </table>
        <h2>Utilities</h2>
        <table>
          <thead><tr><th>Class</th><th>CSS</th></tr></thead>
          <tbody>{utilities.map((u) => <tr><td><code>.{u.cls}</code></td><td><code>{Object.entries(u.decls).map(([p, v]) => `${p}: ${v}`).join('; ')}</code></td></tr>)}</tbody>
        </table>
      </>
    )}
    {view === 'assets' && (Content ? <Content /> : <p>No assets yet.</p>)}
    {view === 'doc' && (
      <>
        {doc.origin === 'override' && <Aside type="note">{m.name} override of the shared {doc.name}. Replaces <code>{doc.replaces}</code>.</Aside>}
        {doc.origin === 'brand' && <Aside type="tip">Only {m.name} has this component.</Aside>}
        {doc.data.uses?.length > 0 && <p>Also uses the CSS from: {doc.data.uses.join(', ')}.</p>}
        <Content />
        <p class="ds-source">Source: <code>{doc.path}</code></p>
      </>
    )}
    {view === 'brief' && (
      <div class="ds-brief">
        <p>
          This is <code>brands/{id}/brief.md</code>: the whole brand in one file, generated from the sources. Agents working in this repo read it directly. For a chat assistant, paste it at the start of the conversation.
        </p>
        <p>
          <button type="button" data-copy>Copy brief</button>
          <a href={`${base}/brands/${id}/brief.md`}>Raw .md</a> · <a href={`${base}/brands/${id}/brand.css`}>brand.css</a> · <a href={`${base}/brands/${id}/tokens.css`}>tokens.css</a>
        </p>
        <pre>{brief}</pre>
      </div>
    )}
  </BrandContext>
</StarlightPage>

<script>
  document.querySelectorAll('.ds-brief [data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.closest('.ds-brief').querySelector('pre').textContent);
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy brief'), 1500);
    });
  });
</script>
