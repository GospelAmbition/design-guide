{
  "name": "design-system",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs",
    "dev": "npm run generate && node -e \"require('fs').rmSync('.astro/data-store.json', { force: true })\" && astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.2.10",
    "style-dictionary": "^5.7.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
