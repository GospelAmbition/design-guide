{
  "meta": {
    "name": "Aurora",
    "description": "Warm, friendly and welcoming. For community and consumer-facing sites.",
    "voice": "Warm, plain-spoken, encouraging. Short sentences. Speak directly to the reader."
  },
  "color": {
    "primary":    { "$value": "#C2410C", "$type": "color", "$description": "Main brand colour. Buttons, links, key highlights." },
    "primary-hover": { "$value": "#9A3412", "$type": "color", "$description": "Hover/pressed state for primary." },
    "secondary":  { "$value": "#0F766E", "$type": "color", "$description": "Supporting colour. Secondary buttons, tags." },
    "background": { "$value": "#FFFBF5", "$type": "color", "$description": "Page background." },
    "surface":    { "$value": "#FFFFFF", "$type": "color", "$description": "Cards and panels." },
    "text":       { "$value": "#292524", "$type": "color", "$description": "Body text. Passes AA on background." },
    "muted":      { "$value": "#78716C", "$type": "color", "$description": "Captions and secondary text. Use at 16px+ only." },
    "border":     { "$value": "#E7E5E4", "$type": "color", "$description": "Dividers and card outlines." }
  },
  "font": {
    "heading": { "$value": "'Fraunces', Georgia, serif", "$type": "fontFamily", "$description": "Headings only." },
    "body":    { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body and UI text." }
  },
  "size": {
    "step-0": { "$value": "1rem",    "$type": "dimension", "$description": "Body text" },
    "step-1": { "$value": "1.25rem", "$type": "dimension", "$description": "Lead paragraph / h4" },
    "step-2": { "$value": "1.563rem","$type": "dimension", "$description": "h3" },
    "step-3": { "$value": "1.953rem","$type": "dimension", "$description": "h2" },
    "step-4": { "$value": "2.441rem","$type": "dimension", "$description": "h1" }
  },
  "radius": {
    "sm": { "$value": "6px",  "$type": "dimension", "$description": "Inputs, tags" },
    "md": { "$value": "12px", "$type": "dimension", "$description": "Cards, buttons" },
    "lg": { "$value": "24px", "$type": "dimension", "$description": "Hero panels" }
  },
  "space": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem",  "$type": "dimension" },
    "3": { "$value": "1rem",    "$type": "dimension" },
    "4": { "$value": "1.5rem",  "$type": "dimension" },
    "5": { "$value": "2.5rem",  "$type": "dimension" }
  },
  "rules": {
    "do": [
      "Use primary for the single most important action on a screen.",
      "Use generous white space; keep body text under 70 characters per line.",
      "Use Fraunces for headings and Inter for everything else.",
      "Keep corners rounded using the radius tokens."
    ],
    "dont": [
      "Don't use primary and secondary together in the same button group.",
      "Don't put muted text on coloured backgrounds.",
      "Don't use more than two font families.",
      "Don't use sharp (0px) corners."
    ]
  }
}
