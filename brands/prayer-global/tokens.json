{
  "$description": "Values are what prayer.global renders. Colour names mirror the site's own CSS variables (--pg-brand-color-light → --color-brand-light) so the two can be mapped one to one.",
  "color": {
    "background":       { "$value": "#FFFFFF", "$type": "color", "$description": "Page background." },
    "text":             { "$value": "#1A3B70", "$type": "color", "$description": "Body text and headings (body colour on the site). Same value as brand-light." },
    "brand":            { "$value": "#11224E", "$type": "color", "$description": "--pg-brand-color. Navy: nav bar on dark pages, footer, .brand-bg sections, text on .btn-white." },
    "brand-light":      { "$value": "#1A3B70", "$type": "color", "$description": "--pg-brand-color-light. Body text, outline buttons, rules." },
    "brand-lighter":    { "$value": "#2C599D", "$type": "color", "$description": "--pg-brand-color-lighter. Links, .btn-primary, hover on light-blue buttons, checkbox tick." },
    "brand-lightest":   { "$value": "#5C83C4", "$type": "color", "$description": "--pg-brand-color-lightest. .btn-primary-light, link hover, donate band, back-to-top button." },
    "brand-highlight":  { "$value": "#AEC5EB", "$type": "color", "$description": "--pg-brand-color-highlight. Hero sub-heading, links in the footer." },
    "brand-very-light": { "$value": "#F1F7FF", "$type": "color", "$description": "--pg-brand-color-very-light. Pale blue tint." },
    "dark":             { "$value": "#0A1227", "$type": "color", "$description": ".dark-bg. Hero background behind the world map." },
    "secondary":        { "$value": "#F2944A", "$type": "color", "$description": "--pg-secondary-color. Brand orange: .btn-secondary, focus outline." },
    "secondary-lighter":{ "$value": "#EDAB77", "$type": "color", "$description": "--pg-secondary-color-lighter." },
    "secondary-darker": { "$value": "#D28041", "$type": "color", "$description": "--pg-secondary-color-darker. Hover on .btn-secondary." },
    "grey":             { "$value": "#ACABAB", "$type": "color", "$description": "--pg-grey. Form field borders, disabled buttons, list dividers." },
    "grey-light":       { "$value": "#F3F5F8", "$type": "color", "$description": "--pg-grey-light." },
    "white":            { "$value": "#FFFFFF", "$type": "color", "$description": "Text on dark sections and on every filled button; outline buttons on dark." },
    "orange-top":       { "$value": "#FFB858", "$type": "color", "$description": "First stop of --gradient-orange (CTA buttons)." },
    "orange-bottom":    { "$value": "#EA7519", "$type": "color", "$description": "Last stop of --gradient-orange (CTA buttons)." },
    "blue-top":         { "$value": "#5A81C0", "$type": "color", "$description": "First stop of --gradient-blue (.cta-blue)." },
    "blue-bottom":      { "$value": "#3F5B88", "$type": "color", "$description": "Last stop of --gradient-blue (.cta-blue)." },
    "band-start":       { "$value": "#1D2F57", "$type": "color", "$description": "First stop of --gradient-blue-orange (feature bands)." }
  },
  "gradient": {
    "orange":      { "$value": "linear-gradient({color.orange-top}, {color.orange-bottom})", "$type": "gradient", "$description": "--orange-gradient. Every .btn-cta." },
    "blue":        { "$value": "linear-gradient({color.blue-top}, {color.blue-bottom})", "$type": "gradient", "$description": "--blue-gradient. .btn-cta.cta-blue." },
    "blue-orange": { "$value": "linear-gradient(90deg, {color.band-start}, 60%, {color.secondary})", "$type": "gradient", "$description": "--blue-orange-gradient. Feature bands (.blue-orange-gradient)." },
    "grey":        { "$value": "linear-gradient(0deg, #0A122718, transparent)", "$type": "gradient", "$description": "--grey-gradient. Faint wash rising from the bottom of the stats section." }
  },
  "shadow": {
    "small": { "$value": "rgba(0, 0, 0, 0.1) 0 3px 4px 1px", "$type": "shadow", "$description": "--small-box-shadow. Buttons (except CTA) and form fields." },
    "drop":  { "$value": "0 4px 2px #0004", "$type": "shadow", "$description": ".drop-shadow, used as filter: drop-shadow(var(--shadow-drop)) around clipped images." }
  },
  "font": {
    "heading": { "$value": "'Bebas Kai', Arial, sans-serif", "$type": "fontFamily", "$description": "--pg-font-family-title. h1–h3. Caps-only, one weight." },
    "body":    { "$value": "'Europa', Arial, sans-serif", "$type": "fontFamily", "$description": "--pg-font-family-base. Everything else, including h4, h5 and .font-base headings." },
    "icons":   { "$value": "'PrayerGlobal'", "$type": "fontFamily", "$description": "The icon font. Only for icon glyphs drawn with CSS content (e.g. the topic-link chevron)." }
  },
  "weight": {
    "regular": { "$value": 400, "$type": "fontWeight", "$description": "Body and headings. The site's CSS says 300, but only Europa Regular (400) ships, so 400 is what renders." },
    "strong":  { "$value": 700, "$type": "fontWeight", "$description": "Buttons, h4, h5, .font-weight-bold. The CTA's 600 also renders as this." },
    "heading": { "$value": 400, "$type": "fontWeight", "$description": "Bebas Kai's only weight." }
  },
  "leading": {
    "body":    { "$value": 1.8, "$type": "number", "$description": "Body text (--bs-body-line-height)." },
    "heading": { "$value": 1.2, "$type": "number", "$description": "h1, h3–h5." },
    "title":   { "$value": 1.1, "$type": "number", "$description": "h2 and .h2." },
    "base":    { "$value": 1.5, "$type": "number", "$description": "Buttons and .lh-base (stats)." },
    "tight":   { "$value": 1,   "$type": "number", "$description": "Icons (.icon)." }
  },
  "size": {
    "body":     { "$value": "1.125rem", "$type": "dimension", "$description": "Body text, 18px (--bs-body-font-size)." },
    "small":    { "$value": "1rem",     "$type": "dimension", "$description": "Buttons." },
    "large":    { "$value": "1.25rem",  "$type": "dimension", "$description": ".btn-lg, topic links (20px)." },
    "footer":   { "$value": "1.2rem",   "$type": "dimension", "$description": ".one-rem: footer text." },
    "nav-title":{ "$value": "1.3rem",   "$type": "dimension", "$description": "The outlined Prayer.Global title in the nav bar." },
    "h1":       { "$value": "6rem",     "$type": "dimension", "$description": "h1. 4rem at ≤768px (--size-h1-md), 3rem at ≤576px (--size-h1-sm)." },
    "h1-md":    { "$value": "4rem",     "$type": "dimension", "$description": "h1 at ≤768px." },
    "h1-sm":    { "$value": "3rem",     "$type": "dimension", "$description": "h1 at ≤576px." },
    "h2":       { "$value": "4rem",     "$type": "dimension", "$description": "h2 (page and section titles) at ≥768px." },
    "h2-sm":    { "$value": "3rem",     "$type": "dimension", "$description": "h2 below 768px, and the .h2 class (statement headings) on desktop." },
    "h2-xs":    { "$value": "2.5rem",   "$type": "dimension", "$description": ".h2 class below 768px." },
    "h3":       { "$value": "2rem",     "$type": "dimension", "$description": "h3." },
    "h4":       { "$value": "1.8rem",   "$type": "dimension", "$description": "h4: Europa bold uppercase." },
    "h5":       { "$value": "1.1rem",   "$type": "dimension", "$description": "h5: Europa bold uppercase." },
    "one-em":   { "$value": "1.5em",    "$type": "dimension", "$description": ".one-em: stat labels, the movement list. 1em at ≤768px." },
    "four-em":  { "$value": "4em",      "$type": "dimension", "$description": ".four-em: stat numbers. 3rem at ≤768px." },
    "icon":     { "$value": "3rem",     "$type": "dimension", "$description": ".icon-small: icons beside section titles, topic-link icons, the hero chevron." },
    "icon-nav": { "$value": "2rem",     "$type": "dimension", "$description": ".two-rem: nav bar icon buttons." },
    "hero-title":   { "$value": "12vh", "$type": "dimension", "$description": "Hero h1. 62px below 768px." },
    "hero-subtitle":{ "$value": "6vh",  "$type": "dimension", "$description": "Hero tagline. 32px below 768px." },
    "hero-logo":    { "$value": "24vh", "$type": "dimension", "$description": "Logo mark in the hero." },
    "hero-cta":     { "$value": "3vh",  "$type": "dimension", "$description": "CTA button in the hero." }
  },
  "radius": {
    "sm":   { "$value": "5px",      "$type": "dimension", "$description": "Language switcher button." },
    "md":   { "$value": "10px",     "$type": "dimension", "$description": "Form fields, icon buttons." },
    "box":  { "$value": "0.375rem", "$type": "dimension", "$description": "The outlined nav title." },
    "pill": { "$value": "100px",    "$type": "dimension", "$description": "Every button." }
  },
  "space": {
    "xxs": { "$value": "0.25rem", "$type": "dimension" },
    "xs": { "$value": "0.5rem",  "$type": "dimension", "$description": "Button padding-y, tight list gaps." },
    "s": { "$value": "1rem",    "$type": "dimension", "$description": "Button padding-x, .flow-small, nav padding." },
    "s-m": { "$value": "1.5rem",  "$type": "dimension", "$description": "Container side padding (gutter 3rem)." },
    "m": { "$value": "2rem",    "$type": "dimension", "$description": ".flow-medium, .switcher-md gap." },
    "l": { "$value": "3rem",    "$type": "dimension", "$description": "Footer and donate band padding (.py-l)." },
    "xl": { "$value": "4rem",    "$type": "dimension", "$description": "Section padding (.py-xl), image overlap margin." },
    "input-y": { "$value": "5px",  "$type": "dimension", "$description": "Form field padding top and bottom." },
    "input-x": { "$value": "10px", "$type": "dimension", "$description": "Form field padding left and right." }
  }
}
