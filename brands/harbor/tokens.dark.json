    "surface":       { "$value": "#111827", "$type": "color", "$description": "Cards and panels." },
    "text":          { "$value": "#E2E8F0", "$type": "color", "$description": "Body text." },
    "muted":         { "$value": "#94A3B8", "$type": "color", "$description": "Captions and secondary text." },
