{
  "color": {
    "primary":       { "$value": "#1D4ED8", "$type": "color", "$description": "Main brand colour. Buttons, links, key highlights." },
    "primary-hover": { "$value": "#1E3A8A", "$type": "color", "$description": "Hover/pressed state for primary." },
    "on-primary":    { "$value": "#FFFFFF", "$type": "color", "$description": "Text and icons on primary." },
    "secondary":     { "$value": "#475569", "$type": "color", "$description": "Supporting colour. Secondary buttons, tags." },
    "on-secondary":  { "$value": "#FFFFFF", "$type": "color", "$description": "Text and icons on secondary." },
    "background":    { "$value": "#F8FAFC", "$type": "color", "$description": "Page background." },
    "surface":       { "$value": "#FFFFFF", "$type": "color", "$description": "Cards and panels." },
    "text":          { "$value": "#0F172A", "$type": "color", "$description": "Body text. Passes AAA on background." },
    "muted":         { "$value": "#64748B", "$type": "color", "$description": "Captions and secondary text. Use at 16px+ only." },
    "border":        { "$value": "#CBD5E1", "$type": "color", "$description": "Dividers and card outlines." }
  },
  "font": {
    "heading": { "$value": "'IBM Plex Sans', system-ui, sans-serif", "$type": "fontFamily", "$description": "Headings only." },
    "body":    { "$value": "'IBM Plex Sans', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body and UI text." }
  },
  "weight": {
    "regular": { "$value": 400, "$type": "fontWeight", "$description": "Body text." },
    "strong":  { "$value": 600, "$type": "fontWeight", "$description": "Buttons, labels, emphasis." },
    "heading": { "$value": 600, "$type": "fontWeight", "$description": "Headings." }
  },
  "leading": {
    "body":    { "$value": 1.5,  "$type": "number", "$description": "Line height for body text." },
    "heading": { "$value": 1.25, "$type": "number", "$description": "Line height for headings." }
  },
  "size": {
    "small":   { "$value": "0.8125rem", "$type": "dimension", "$description": "Small print, tags" },
    "step-0":  { "$value": "0.9375rem", "$type": "dimension", "$description": "Body text" },
    "step-1":  { "$value": "1.125rem",  "$type": "dimension", "$description": "Lead paragraph / h4" },
    "step-2":  { "$value": "1.375rem",  "$type": "dimension", "$description": "h3" },
    "step-3":  { "$value": "1.75rem",   "$type": "dimension", "$description": "h2" },
    "step-4":  { "$value": "2.125rem",  "$type": "dimension", "$description": "h1" }
  },
  "radius": {
    "sm": { "$value": "2px", "$type": "dimension", "$description": "Inputs, tags" },
    "md": { "$value": "4px", "$type": "dimension", "$description": "Cards, buttons" },
    "lg": { "$value": "8px", "$type": "dimension", "$description": "Panels" }
  },
  "space": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem",  "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1.25rem", "$type": "dimension" },
    "5": { "$value": "2rem",    "$type": "dimension" }
  }
}
